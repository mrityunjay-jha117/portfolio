generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id           String    @id @default(uuid())
  title        String
  createdAt    DateTime  @default(now())
  tags         String[]  //always when storing put it in lowercase to avoid case sensitivity issues
  link         String
}

